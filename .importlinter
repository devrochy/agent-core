[importlinter]
root_package = core
# Los packs viven en paquetes separados (instalados con `pip install -e`); sin esto
# grimp no los resuelve y solo miraría el árbol de `core`.
include_external_packages = True

# Invariante 5: ningún pack importa de otro pack. Los packs solo dependen del core
# y se coordinan por registros del core (payment_registry, subscription_registry)
# o por eventos.
[importlinter:contract:pack-independencia]
name = Ningún pack importa de otro pack
type = independence
modules =
    pack_calendar
    pack_cobranza
    pack_commerce
    pack_payments
    pack_subscriptions

[importlinter:contract:packs-sin-cli]
name = Los packs no importan la CLI
type = forbidden
source_modules =
    pack_calendar
    pack_cobranza
    pack_commerce
    pack_payments
    pack_subscriptions
forbidden_modules =
    cli

[importlinter:contract:contracts-sin-dependencias]
name = agentcore_contracts no importa del runtime
type = forbidden
source_modules =
    agentcore_contracts
forbidden_modules =
    core
    cli
    pack_calendar
    pack_cobranza
    pack_commerce
    pack_payments
    pack_subscriptions
