{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "docs": {
      "path": "~/Proyectos/solvershub/solvershub-docs",
      "description": "Plan SDD de SolversHub: HU, specs, decisiones y bitácora. Úsalo al trabajar una HU con la skill ejecutar-hu."
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "ruff*": "allow",
      "pytest*": "allow",
      "uv*": "allow",
      "pnpm lint*": "allow",
      "pnpm test*": "allow",
      "pnpm build*": "allow",
      "pnpm tsc*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rg*": "allow",
      "cloc*": "allow",
      "git push --force*": "deny"
    }
  }
}