{
  "nombre": "subir-de-plan",
  "descripcion": "Basic → Premium: cargo por la diferencia prorrateada con link, el plan cambia al pagarlo y queda con el precio del catálogo (HU-SUB-07).",
  "pasos": [
    {
      "nota": "cliente con Basic activo",
      "accion": "activar_suscripcion",
      "datos": {
        "plan": {
          "plan_code": "PLAN-BASIC",
          "nombre": "Plan Basic",
          "precio": 200000,
          "moneda": "COP",
          "periodicidad": "mensual",
          "trial_dias": 0
        }
      }
    },
    {
      "nota": "pide subir de plan",
      "usuario": "Quiero pasarme del Plan Basic al Plan Premium.",
      "hasta_herramienta": "sub_cambiar_plan",
      "insistir": "Sí, confirmo el cambio al Plan Premium.",
      "max_turnos": 4,
      "espera": {
        "texto_contiene": [
          "https://pagos.simulados/"
        ]
      }
    },
    {
      "nota": "cargo por la diferencia",
      "verifica": {
        "tabla": "pack_subscriptions_charges",
        "donde": {
          "subscription_id": "{suscripcion.subscription_id}",
          "tipo": "cambio_plan"
        },
        "filas": 1,
        "espera": {
          "estado": "pendiente",
          "monto": {
            "$en": [
              386667,
              400000,
              413333
            ]
          }
        },
        "guardar_como": "cargo"
      }
    },
    {
      "nota": "todavía en Basic",
      "verifica": {
        "tabla": "pack_subscriptions_subscriptions",
        "donde": {
          "id": "{suscripcion.subscription_id}"
        },
        "espera": {
          "concepto": {
            "$contiene": "Basic"
          }
        }
      }
    },
    {
      "nota": "paga la diferencia",
      "evento": "payment.confirmed",
      "datos": {
        "reference": "sub-{cargo.id}",
        "provider": "simulado",
        "provider_reference": "sim-cambio",
        "amount": "{cargo.monto}"
      }
    },
    {
      "nota": "Premium al precio del catálogo",
      "verifica": {
        "tabla": "pack_subscriptions_subscriptions",
        "donde": {
          "id": "{suscripcion.subscription_id}"
        },
        "espera": {
          "concepto": {
            "$contiene": "Premium"
          },
          "valor_periodo": 600000
        }
      }
    }
  ]
}
