{
  "nombre": "contratar-premium-mensual",
  "semilla": 7,
  "procedimientos": [
    "pack_subscriptions.contratar_plan"
  ],
  "descripcion": "Gherkin 1 de HU-AOS-07 (contratar_plan): el cliente simulado compra el Premium mensual con pago en línea. El pedido tiene la variante y el total del servidor y el link cobra ese total. Para medir pass^4 en vivo (con OK del dueño).",
  "pasos": [
    {
      "nota": "el cliente simulado conversa hasta recibir el link",
      "simulado": {
        "objetivo": "Contratar el Plan Premium MENSUAL y pagarlo en línea. Tu objetivo se cumple cuando te mandan el link de pago.",
        "datos": {
          "nombre": "Ana Gómez",
          "cedula": "{cliente.documento}",
          "celular": "{cliente.celular}",
          "correo": "ana+{cliente.id}@example.com",
          "medio_de_pago": "pago en línea"
        },
        "max_turnos": 10
      },
      "espera_fin": [
        "objetivo"
      ]
    },
    {
      "nota": "un pedido por el total del Premium mensual",
      "verifica": {
        "tabla": "pack_commerce_orders",
        "donde": {
          "customer_id": "{cliente.id}"
        },
        "filas": 1,
        "espera": {
          "payment_status": "pendiente",
          "total": 600000
        },
        "guardar_como": "pedido"
      }
    },
    {
      "nota": "la línea es la variante mensual",
      "verifica": {
        "tabla": "pack_commerce_order_items",
        "donde": {
          "order_id": "{pedido.id}"
        },
        "filas": 1,
        "espera": {
          "unit_price": 600000,
          "quantity": 1
        },
        "orden": "id"
      }
    },
    {
      "nota": "el link cobra el total del pedido",
      "verifica": {
        "tabla": "pack_payments_transactions",
        "donde": {
          "reference": "{pedido.public_order_number}"
        },
        "filas": 1,
        "espera": {
          "amount": 600000,
          "provider": "simulado"
        }
      }
    }
  ]
}
