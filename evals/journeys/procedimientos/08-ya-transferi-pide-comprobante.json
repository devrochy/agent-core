{
  "nombre": "ya-transferi-pide-comprobante",
  "semilla": 13,
  "procedimientos": [
    "pack_commerce.comprobar_transferencia"
  ],
  "descripcion": "HU-COM-24: con un pedido por transferencia, el cliente dice que ya transfirió sin mandar la foto; el agente pide el comprobante y no da el pedido por pagado.",
  "pasos": [
    {
      "nota": "el cliente hace un pedido por transferencia",
      "simulado": {
        "objetivo": "Pedir dos hamburguesas a domicilio y pagar por transferencia. Da tus datos solo cuando te los pidan. Tu objetivo se cumple cuando te confirman el pedido.",
        "datos": {
          "nombre": "Ana Gómez",
          "celular": "3001234567",
          "direccion": "Calle 10 # 20-30",
          "ciudad": "Bogotá",
          "medio_de_pago": "por transferencia"
        },
        "max_turnos": 10
      },
      "espera_fin": [
        "objetivo"
      ]
    },
    {
      "nota": "dice que ya transfirió",
      "usuario": "Ya hice la transferencia",
      "espera": {
        "texto_contiene": [
          "comprobante"
        ]
      }
    },
    {
      "nota": "el pedido no queda pagado",
      "verifica": {
        "tabla": "pack_commerce_orders",
        "donde": {
          "customer_id": "{cliente.id}"
        },
        "filas": 1,
        "espera": {
          "payment_status": {
            "$en": [
              "pendiente",
              "en_revision"
            ]
          }
        }
      }
    }
  ]
}