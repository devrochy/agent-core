{
  "name": "venta-actualizar-perfil-26",
  "requires_plugins": ["pack_commerce"],
  "conversation": [
    {"role": "user", "content": "Hola, soy Luis y quiero comprar para mi negocio."},
    {
      "role": "assistant",
      "content": "¡Hola Luis! Ya te registré como interesado en el CRM. ¿Hay algo más que quieras contarme?",
      "tool_calls": [
        {
          "name": "crear_lead",
          "arguments": {"name": "Luis", "interest": "comprar para su negocio"},
          "result": {"lead_id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d", "status": "created"}
        }
      ]
    },
    {"role": "user", "content": "Por si acaso, mi teléfono es 3111234567 y prefiero que me llamen por la tarde."}
  ],
  "assertions": {
    "must_call_tool": "actualizar_lead",
    "must_not_contain": ["error"],
    "max_response_chars": 400
  }
}