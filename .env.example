# ============================================================
# agent-core — Variables de entorno
# Copia este archivo a .env y completa los valores.
# `agent-core init` genera este archivo automáticamente.
# ============================================================

# --- Aplicación ---
APP_NAME="Mi Asistente"
APP_ENV=development            # development | production
APP_SECRET_KEY=change-me       # Firma de cookies de sesión. Genera: openssl rand -hex 32
PUBLIC_BASE_URL=http://localhost:8000
# Prefijo de ruta si la app se sirve detrás de un proxy bajo un prefijo
# (ej. ROOT_PATH=/agent-core). Vacío = servida en la raíz. Ver ADR-0073.
ROOT_PATH=

# --- Base de datos (PostgreSQL 16 + pgvector) ---
# El RUNTIME conecta como app_runtime (NO dueño): RLS se aplica de verdad (ADR-0001).
# La migración 0003 crea el rol app_runtime y sus grants automáticamente.
# Las MIGRACIONES corren como el DUEÑO (MIGRATIONS_DATABASE_URL); si queda vacío se usa DATABASE_URL.
# En producción cambia las contraseñas (no las del ejemplo).
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime@localhost:5432/agent_core
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://agent_core:agent_core@localhost:5432/agent_core

# --- Redis (working memory, colas, debounce, idempotencia) ---
REDIS_URL=redis://localhost:6379/0

# --- Cifrado de secretos en BD ---
# MASTER_ENCRYPTION_KEY (Fernet, legado): solo para LEER datos cifrados antes
# de la migración a AES-256-GCM. Genera:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=
# TOKEN_MASTER_KEYS/TOKEN_ACTIVE_KEY_ID (AES-256-GCM, formato nuevo -- todo
# cifrado se escribe con esto). Rotación: agregá una clave nueva a
# TOKEN_MASTER_KEYS sin borrar las viejas, y recién después cambiá
# TOKEN_ACTIVE_KEY_ID -- las filas viejas se siguen leyendo con su key_id.
# Genera una clave: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_MASTER_KEYS={"k1":""}
TOKEN_ACTIVE_KEY_ID=k1

# --- LLM (proveedor por defecto: DeepSeek) ---
LLM_PROVIDER=deepseek          # deepseek | openai | anthropic | openai_compatible
LLM_API_KEY=
# Modelos V4 vigentes. `deepseek-chat`/`deepseek-reasoner` se discontinuaron el
# 2026-07-24 (P-05): no usarlos ni como respaldo.
LLM_MODEL=deepseek-flash        # modelo económico por defecto (thinking off)
LLM_MODEL_REASONING=deepseek-flash  # mismo modelo, con thinking on para dificultad alta
LLM_MODEL_FALLBACK=gpt-4o-mini  # respaldo ante error del proveedor (no usar Gemini 2.5 Flash-Lite)
LLM_BASE_URL=https://api.deepseek.com  # solo para proveedores openai-compatible
LLM_MAX_TOKENS=4096
DIFFICULTY_ROUTING=true        # enruta chat (thinking off) vs razonamiento (thinking on)
LLM_THINKING_DEFAULT=false     # los IDs V4 encienden thinking por defecto: el chat lo apaga
LLM_THINKING_REASONING=true    # el turno de razonamiento lo enciende explícitamente

# --- Multimedia entrante (SPEC-04, ADR-0151) ---
# Fallback de plataforma. Cada negocio puede elegir proveedor/modelo/llave en
# Configuración → Multimedia (BYOK); si no lo hace, se usa esto.
STT_PROVIDER=groq              # groq | openai
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=                   # llave de plataforma para STT (si falta, se usa la del proveedor)
VISION_PROVIDER=deepseek       # deepseek | anthropic | openai
VISION_MODEL=deepseek-flash
VISION_API_KEY=                # llave de plataforma para visión (si falta, se usa la del proveedor)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MEDIA_MAX_BYTES=16777216       # 16 MB
MEDIA_DOWNLOAD_TIMEOUT_S=20
STT_TIMEOUT_S=45
VISION_TIMEOUT_S=45

# --- Embeddings (memoria vectorial, Capa 3) ---
# DeepSeek NO tiene API de embeddings. Opciones:
#   local  -> sentence-transformers (gratis, sin API). Requiere: pip install agent-core[embeddings-local]
#   openai -> text-embedding-3-small (requiere OPENAI_API_KEY)
#   none   -> desactiva la memoria vectorial
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Retención de la memoria semántica en días (0 = sin purga automática)
MEMORY_RETENTION_DAYS=0
OPENAI_API_KEY=

# --- Canal: WhatsApp (Meta Cloud API) ---
# Estas credenciales también pueden gestionarse desde el panel admin (cifradas en BD).
WHATSAPP_VERIFY_TOKEN=         # token que registras en el webhook de Meta
WHATSAPP_APP_SECRET=           # para verificar firma HMAC-SHA256 (obligatoria en producción: webhook fail-closed)
# Solo para entornos de prueba: permite webhooks sin firma. NUNCA en producción.
WEBHOOK_ALLOW_UNSIGNED=false
WHATSAPP_ACCESS_TOKEN=         # token de acceso de la app Meta
WHATSAPP_PHONE_NUMBER_ID=      # phone_number_id del número de WhatsApp Business

# --- Canal: WhatsApp Web no oficial (waweb, ADR-0074) ---
# Canal NO oficial (protocolo de WhatsApp Web): el número vinculado PUEDE ser
# suspendido por WhatsApp. Apagado por defecto. Para usarlo:
#   WAWEB_ENABLED=true + `docker compose --profile waweb up -d waweb-connector`
WAWEB_ENABLED=false
# Directorio de sesiones efímeras (en compose corre en tmpfs; la copia durable
# y cifrada vive en la BD: waweb_sessions.creds_encrypted).
WAWEB_SESSION_DIR=/tmp/waweb-sessions
WAWEB_SWEEP_INTERVAL_S=15
WAWEB_RECONNECT_MAX_S=60

# --- Modo demo (SOLO desarrollo) ---
# DEMO_MODE=true usa un LLM fake determinístico y un envío de canal no-op para
# probar el pipeline sin API key. Prohibido en producción: ahí va LLM_API_KEY real.
DEMO_MODE=false

# --- Comportamiento del asistente ---
DEBOUNCE_MODE=natural          # inmediato | corto (3s) | rapido (5s) | natural (15s) | pausado (30s)
MAX_AGENT_ITERATIONS=6         # máximo de vueltas del agentic loop por turno
MESSAGE_SPLIT_STYLE=pocos_cortos  # un_mensaje | pocos_cortos | varios_cortos

# --- Concurrencia de turnos (ADR-0006) ---
MAX_CONCURRENT_TURNS=8         # turnos concurrentes del worker
MAX_TURNS_PER_TENANT=2         # techo por tenant: un tenant ruidoso no ahoga a los demás

# --- Observabilidad ---
LOG_LEVEL=INFO
# Trazas OpenTelemetry: OTEL_ENABLED=true activa spans (turno/llm_call/tool).
# Si OTEL_EXPORTER_OTLP_ENDPOINT está set, exporta vía OTLP/HTTP; si no, consola.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-core

# --- Tenants (multi-tenant, ADR-0001) ---
# Carpeta con los artefactos de cada tenant (catalog.json, docs/, evals/).
# Por defecto `tenants/` dentro del repo (gitignored): cada despliegue tiene la suya.
TENANTS_ROOT=tenants

# --- Planes y facturación de tenants (ADR-0045 / ADR-0046) ---
# Cobro de la SUSCRIPCIÓN de plataforma (el tenant paga su plan), separado del
# cobro del negocio del tenant (eso es pack-payments). `none` = pasarela apagada
# (el panel muestra los planes pero no permite suscribirse).
BILLING_PROVIDER=none            # none | wompi
BILLING_CURRENCY=COP
BILLING_TRIAL_DAYS=30            # días de operación gratuita del plan free
WOMPI_BILLING_PUBLIC_KEY=
WOMPI_BILLING_PRIVATE_KEY=
WOMPI_BILLING_EVENTS_SECRET=
WOMPI_BILLING_SANDBOX=true       # false solo en producción con llaves reales

# URL del panel nuevo: a donde vuelve el navegador tras el OAuth de Google.
PANEL_BASE_URL=http://192.168.40.15:3200

# --- Correo de sistema (recuperación de contraseña, ADR-0098) ---
# SMTP de la plataforma para correos sin contexto de negocio (p. ej. el código
# de recuperación). Sin SYSTEM_SMTP_HOST, el envío es log-only y el flujo de
# recuperación sigue respondiendo (el código queda sin entregar).
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM=

# --- Notificaciones push de la app oficial (ADR-0099) ---
# Expo Push Service (projectId de EAS). Sin EXPO_PUSH_ENABLED, el envío es
# log-only y el flujo sigue (igual que SYSTEM_SMTP_*).
EXPO_PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
