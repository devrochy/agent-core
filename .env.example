# ============================================================
# agent-core — Variables de entorno
# Copia este archivo a .env y completa los valores.
# `agent-core init` genera este archivo automáticamente.
# ============================================================

# --- Aplicación ---
APP_NAME="Mi Asistente"
APP_ENV=development            # development | production
APP_SECRET_KEY=change-me       # Firma de cookies de sesión. Genera: openssl rand -hex 32
PUBLIC_BASE_URL=http://localhost:8000

# --- Base de datos (PostgreSQL 16 + pgvector) ---
# El RUNTIME conecta como app_runtime (NO dueño): RLS se aplica de verdad (ADR-0001).
# La migración 0003 crea el rol app_runtime y sus grants automáticamente.
# Las MIGRACIONES corren como el DUEÑO (MIGRATIONS_DATABASE_URL); si queda vacío se usa DATABASE_URL.
# En producción cambia las contraseñas (no las del ejemplo).
DATABASE_URL=postgresql+asyncpg://app_runtime:app_runtime@localhost:5432/agent_core
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://agent_core:agent_core@localhost:5432/agent_core

# --- Redis (working memory, colas, debounce, idempotencia) ---
REDIS_URL=redis://localhost:6379/0

# --- Cifrado de secretos en BD ---
# MASTER_ENCRYPTION_KEY (Fernet, legado): solo para LEER datos cifrados antes
# de la migración a AES-256-GCM. Genera:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=
# TOKEN_MASTER_KEYS/TOKEN_ACTIVE_KEY_ID (AES-256-GCM, formato nuevo -- todo
# cifrado se escribe con esto). Rotación: agregá una clave nueva a
# TOKEN_MASTER_KEYS sin borrar las viejas, y recién después cambiá
# TOKEN_ACTIVE_KEY_ID -- las filas viejas se siguen leyendo con su key_id.
# Genera una clave: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_MASTER_KEYS={"k1":""}
TOKEN_ACTIVE_KEY_ID=k1

# --- LLM (proveedor por defecto: DeepSeek) ---
LLM_PROVIDER=deepseek          # deepseek | openai | anthropic | openai_compatible
LLM_API_KEY=
LLM_MODEL=deepseek-chat        # modelo económico por defecto
LLM_MODEL_REASONING=deepseek-reasoner  # modelo para dificultad alta (difficulty routing)
LLM_BASE_URL=https://api.deepseek.com  # solo para proveedores openai-compatible
LLM_MAX_TOKENS=4096
DIFFICULTY_ROUTING=true        # enruta automáticamente chat vs reasoner

# --- Embeddings (memoria vectorial, Capa 3) ---
# DeepSeek NO tiene API de embeddings. Opciones:
#   local  -> sentence-transformers (gratis, sin API). Requiere: pip install agent-core[embeddings-local]
#   openai -> text-embedding-3-small (requiere OPENAI_API_KEY)
#   none   -> desactiva la memoria vectorial
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=

# --- Canal: WhatsApp (Meta Cloud API) ---
# Estas credenciales también pueden gestionarse desde el panel admin (cifradas en BD).
WHATSAPP_VERIFY_TOKEN=         # token que registras en el webhook de Meta
WHATSAPP_APP_SECRET=           # para verificar firma HMAC-SHA256
WHATSAPP_ACCESS_TOKEN=         # token de acceso de la app Meta
WHATSAPP_PHONE_NUMBER_ID=      # phone_number_id del número de WhatsApp Business

# --- Modo demo (SOLO desarrollo) ---
# DEMO_MODE=true usa un LLM fake determinístico y un envío de canal no-op para
# probar el pipeline sin API key. Prohibido en producción: ahí va LLM_API_KEY real.
DEMO_MODE=false

# --- Comportamiento del asistente ---
DEBOUNCE_MODE=natural          # inmediato | corto (3s) | rapido (5s) | natural (15s) | pausado (30s)
MAX_AGENT_ITERATIONS=6         # máximo de vueltas del agentic loop por turno
MESSAGE_SPLIT_STYLE=pocos_cortos  # un_mensaje | pocos_cortos | varios_cortos

# --- Concurrencia de turnos (ADR-0006) ---
MAX_CONCURRENT_TURNS=8         # turnos concurrentes del worker
MAX_TURNS_PER_TENANT=2         # techo por tenant: un tenant ruidoso no ahoga a los demás

# --- Observabilidad ---
LOG_LEVEL=INFO
# Trazas OpenTelemetry: OTEL_ENABLED=true activa spans (turno/llm_call/tool).
# Si OTEL_EXPORTER_OTLP_ENDPOINT está set, exporta vía OTLP/HTTP; si no, consola.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-core

# --- Tenants (multi-tenant, ADR-0001) ---
# Carpeta con los artefactos de cada tenant (catalog.json, docs/, evals/).
# Por defecto `tenants/` dentro del repo (gitignored): cada despliegue tiene la suya.
TENANTS_ROOT=tenants
