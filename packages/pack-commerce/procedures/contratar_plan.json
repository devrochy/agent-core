{
  "contract": "procedure/1",
  "id": "pack_commerce.contratar_plan",
  "version": "1.1.0",
  "title": "Contratar un plan",
  "triggers": {
    "description": "El cliente quiere comprar, contratar o pagar un plan o suscripción del negocio.",
    "examples": [
      "quiero el plan premium",
      "cómo pago el básico",
      "lo quiero contratar",
      "quiero suscribirme",
      "mándame el link para pagar el plan"
    ]
  },
  "slots": {
    "variant_id": {
      "type": "string",
      "required": true,
      "resolver": "pack_commerce.variante_de_plan"
    },
    "quote_id": {
      "type": "string",
      "setBy": "action:cotizar_plan"
    },
    "requiere_pago": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_full_name": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_id_document": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_phone": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_email": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_business_name": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_vertical": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_address": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_municipality": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "pide_city": {
      "type": "boolean",
      "setBy": "action:cotizar_plan"
    },
    "full_name": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_full_name",
        "equals": true
      },
      "dataClass": "pii"
    },
    "id_document": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_id_document",
        "equals": true
      },
      "dataClass": "pii"
    },
    "phone": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_phone",
        "equals": true
      },
      "dataClass": "pii",
      "format": "phone"
    },
    "email": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_email",
        "equals": true
      },
      "dataClass": "pii",
      "format": "email",
      "confirm": true
    },
    "business_name": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_business_name",
        "equals": true
      },
      "dataClass": "public",
      "resolver": "pack_commerce.nombre_de_negocio"
    },
    "vertical": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_vertical",
        "equals": true
      },
      "dataClass": "public",
      "resolver": "pack_commerce.tipo_de_negocio"
    },
    "address": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_address",
        "equals": true
      },
      "dataClass": "pii"
    },
    "municipality": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_municipality",
        "equals": true
      },
      "dataClass": "pii"
    },
    "city": {
      "type": "string",
      "requiredWhen": {
        "slot": "pide_city",
        "equals": true
      },
      "dataClass": "pii"
    },
    "payment_method": {
      "enum": [
        "pago_en_linea",
        "transferencia",
        "efectivo_contraentrega"
      ],
      "requiredWhen": {
        "slot": "requiere_pago",
        "equals": true
      },
      "resolver": "pack_commerce.metodo_de_pago"
    },
    "order_id": {
      "type": "string",
      "setBy": "action:crear_pedido"
    },
    "link": {
      "type": "string",
      "format": "uri",
      "setBy": "action:confirmar_pago_pedido",
      "requiredWhen": {
        "slot": "payment_method",
        "equals": "pago_en_linea"
      }
    },
    "pago_confirmado": {
      "type": "boolean",
      "setBy": "action:verificar_pago_pedido",
      "requiredWhen": {
        "slot": "payment_method",
        "equals": "pago_en_linea"
      }
    }
  },
  "stages": [
    {
      "id": "elegir_plan",
      "goal": "Que el cliente elija un plan con precios reales del catálogo.",
      "actions": [
        "consultar_inventario",
        "informar_plan"
      ],
      "exitWhen": {
        "slots": [
          "variant_id"
        ]
      }
    },
    {
      "id": "cotizar",
      "goal": "Cotizar el plan elegido con el precio del servidor y aplicar la promoción si corresponde.",
      "actions": [
        "cotizar_plan",
        "aplicar_promocion",
        "consultar_inventario"
      ],
      "exitWhen": {
        "slots": [
          "quote_id"
        ]
      }
    },
    {
      "id": "datos",
      "goal": "Pedir los datos que el negocio exige para el plan y confirmar el correo.",
      "actions": [
        "consultar_inventario"
      ],
      "exitWhen": {
        "slots": [
          "full_name",
          "id_document",
          "phone",
          "email",
          "business_name",
          "vertical",
          "address",
          "municipality",
          "city",
          "payment_method"
        ],
        "confirmed": [
          "email"
        ]
      }
    },
    {
      "id": "confirmar",
      "goal": "Mostrar el total del servidor y pedir la confirmación explícita del cliente.",
      "actions": [
        "confirmar_cotizacion",
        "consultar_inventario"
      ],
      "confirmation": "interactive_button",
      "exitWhen": {
        "action": "confirmar_cotizacion",
        "ok": true
      }
    },
    {
      "id": "pagar",
      "goal": "Crear el pedido y, si paga en línea, enviar el link de pago.",
      "risk": "high",
      "actions": [
        "crear_pedido",
        "confirmar_pago_pedido"
      ],
      "exitWhen": {
        "slots": [
          "order_id",
          "link"
        ]
      }
    },
    {
      "id": "esperar_pago",
      "goal": "El link ya salió: esperar a que el pago en línea se confirme. Si el cliente dice que ya pagó, verificarlo; si pide el link o venció, reenviarlo (sale uno nuevo si venció). Con transferencia, contraentrega o sin cobro la etapa no aplica.",
      "actions": [
        "verificar_pago_pedido",
        "confirmar_pago_pedido",
        "consultar_inventario"
      ],
      "exitWhen": {
        "slots": [
          "pago_confirmado"
        ]
      }
    }
  ],
  "completion": {
    "events": [
      "pack_commerce.order.paid"
    ],
    "returnControl": true
  },
  "recovery": {
    "actionError": "explicar"
  },
  "claims": [
    {
      "kind": "amount",
      "mustMatch": [
        "action:cotizar_plan.total",
        "action:aplicar_promocion.total",
        "action:confirmar_cotizacion.total"
      ]
    },
    {
      "kind": "link",
      "mustMatch": [
        "slot:link"
      ]
    },
    {
      "kind": "status",
      "phrases": [
        "pedido creado",
        "pedido quedó creado",
        "pedido quedó confirmado",
        "quedó registrado tu pedido"
      ],
      "requires": "slot:order_id"
    }
  ],
  "evals": [
    "contratar-premium-mensual",
    "contratar-cambia-de-plan",
    "contratar-free-sin-link",
    "contratar-transferencia"
  ]
}
