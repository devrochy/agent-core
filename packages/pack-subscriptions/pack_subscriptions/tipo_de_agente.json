      "defecto": "normal",
      "opciones": [
        {
          "id": "cortas",
          "texto": "Cortas",
          "ayuda": "Directas, pensadas para el celular.",
          "largo_maximo": 300
        },
        {
          "id": "normal",
          "texto": "Normales",
          "ayuda": "Lo habitual de tu negocio."
        },
        {
          "id": "detalladas",
          "texto": "Detalladas",
          "ayuda": "Explica con más detalle.",
          "largo_maximo": 900
        }
      ]
    }
  ]
